FROM node:22.23.5-bookworm-slim@sha256:be979e5523c76fa4d5ca4ebd3099078f220aa47ec39c48ad5b5df9314debd6eb

ENV npm_config_store_dir=/pnpm/store

WORKDIR /app

COPY --chown=node:node package.json pnpm-lock.yaml ./
COPY docker/dev-entrypoint.sh /usr/local/bin/kb-dev

RUN --mount=type=cache,target=/root/.npm,sharing=locked \
    npm install --global --no-audit --no-fund "$(node -p 'require("./package.json").packageManager')" \
    && install -d -o node -g node /pnpm/store \
    && chown node:node /app

USER node

RUN --mount=type=cache,id=kb-portfolio-pnpm,target=/pnpm/store,uid=1000,gid=1000,sharing=locked \
    sh /usr/local/bin/kb-dev --deps-only

COPY --chown=node:node . .

EXPOSE 5173

CMD ["sh", "/usr/local/bin/kb-dev"]
