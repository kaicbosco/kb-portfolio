# Allow only project inputs; local credentials and generated files stay out.
**
!Dockerfile
!docker
docker/**
!docker/Dockerfile.dev
!docker/dev-entrypoint.sh
!docker/nginx.conf
!package.json
!pnpm-lock.yaml
!index.html
!env.d.ts
!tsconfig*.json
!vite.config.ts
!vitest.config.ts
!playwright.config.ts
!.oxlintrc.json
!.prettierignore
!.prettierrc.json
!.nvmrc
!src
!public
!e2e
!docs
!README.md
!CHANGELOG.md
!AGENTS.md

# Exclude local artifacts even below an included directory.
**/node_modules
**/.env
**/.env.*
**/.npmrc
**/.git
**/.ssh
**/*.key
**/*.pem
**/*.p12
**/*.pfx
**/receipts
**/review-receipts
**/*.local
**/*.log
**/.DS_Store
